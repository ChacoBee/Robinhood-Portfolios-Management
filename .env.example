# Public-safe default. Demo mode never reads broker or database credentials.
APP_MODE=demo
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=8787

# Connected mode only. Provision these in the server runtime, never in apps/web.
# DATABASE_URL=postgresql://aurum:change-me@localhost:5432/aurum
# OWNER_EMAIL=owner@example.com
# CLERK_SECRET_KEY=replace-with-managed-secret
# ROBINHOOD_MCP_URL=https://your-readonly-mcp.example/mcp
# ROBINHOOD_READONLY_SCOPES=accounts:read,positions:read,history:read,quotes:read
