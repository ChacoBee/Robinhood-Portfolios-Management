# Public-safe default. Demo mode never reads broker or database credentials.
APP_MODE=demo
NODE_ENV=development
# Demo origin. Replace with the exact HTTPS site origin in Connected mode.
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=8787
AURUM_DATA_MODE=demo
# AURUM_API_URL=https://api.portfolio.example.com

# Connected mode only. Provision these in the server runtime, never in apps/web.
# DATABASE_URL=postgresql://aurum:change-me@db.example.com:5432/aurum?sslmode=verify-full
# OWNER_CLERK_USER_ID=user_replace_me
# OWNER_EMAIL=owner@example.com
# CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# CLERK_ISSUER_URL=https://clerk.portfolio.example.com
# CLERK_SECRET_KEY=replace-with-managed-secret
# CSRF_SECRET=replace-with-at-least-32-random-characters
# ACCOUNT_REFERENCE_ENCRYPTION_KEY=<base64-encoded 32-byte key>
# AURUM_TRUSTED_COMPOSITION_MODULE=/run/secrets/aurum-composition.mjs
# The private module must export createApiComposition (owner verifier + health
# probe) and createWorkerComposition (verified read grant + alert evaluator).

# Robinhood endpoint, actual OAuth scopes, and access tokens are deliberately
# not accepted from env. The connected worker requires an injected provider
# that verifies the live grant and pins the approved MCP origin.
