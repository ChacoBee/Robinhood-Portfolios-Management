# Copy to ignored .env for local connected operations. Every value below is a
# deliberately non-working placeholder; generate unique secrets before use.
APP_MODE=connected
NODE_ENV=development
AURUM_DATA_MODE=connected

# Local Compose-only PostgreSQL. Keep POSTGRES_PASSWORD URL-safe because it is
# repeated in DATABASE_URL. Production uses a TLS endpoint and sslmode=verify-full.
POSTGRES_DB=aurum
POSTGRES_USER=aurum
POSTGRES_PASSWORD=replace-with-url-safe-local-password
DATABASE_URL=postgresql://aurum:replace-with-url-safe-local-password@postgres:5432/aurum

# Local development may use this exact loopback HTTP origin. Production must be
# an exact HTTPS origin, without a path, query, fragment, or credentials.
WEB_ORIGIN=http://127.0.0.1:3000
OWNER_CLERK_USER_ID=user_replace_with_real_owner_id
OWNER_EMAIL=owner@example.invalid

# Clerk values are split by process. The publishable key reaches only the web;
# the secret key reaches only the API. These values are intentionally invalid.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_real_publishable_key
CLERK_ISSUER_URL=https://replace-with-real-clerk-issuer.invalid
CLERK_SECRET_KEY=replace-with-managed-clerk-secret-not-a-real-secret
CSRF_SECRET=replace-with-a-unique-32-character-minimum-csrf-secret

# Generate two distinct 32-byte base64 values. Do not reuse either value.
ACCOUNT_REFERENCE_ENCRYPTION_KEY=replace-with-distinct-base64-32-byte-account-reference-key
ROBINHOOD_OAUTH_ENCRYPTION_KEY=replace-with-distinct-base64-32-byte-oauth-key

# Docker supplies the private trusted composition path and fixed internal BFF
# API URL. Do not add Robinhood passwords, authorization codes, tokens, or
# account numbers to this file.
