# Public-safe default. Demo mode never reads broker or database credentials.
APP_MODE=demo
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=8787

# Connected mode only. Provision these in the server runtime, never in apps/web.
# DATABASE_URL=postgresql://aurum:change-me@localhost:5432/aurum
# OWNER_EMAIL=owner@example.com
# CLERK_SECRET_KEY=replace-with-managed-secret
# ACCOUNT_REFERENCE_ENCRYPTION_KEY=<base64-encoded 32-byte key>

# Robinhood endpoint, actual OAuth scopes, and access tokens are deliberately
# not accepted from env. The connected worker requires an injected provider
# that verifies the live grant and pins the approved MCP origin.
